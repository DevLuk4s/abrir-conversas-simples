{
  "manifest_version": 3,
  "name": "Abrir Conversas - Prospeccao WhatsApp",
  "version": "1.0.0",
  "description": "Painel de prospeccao com disparo automatico humanizado no WhatsApp Web.",
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Abrir painel de prospeccao" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["protocolo.js", "content-whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
